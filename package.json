{
  "name": "cheapeats",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender-seo.mjs",
    "lint": "oxlint",
    "test:e2e": "playwright test",
    "audit:catalog": "node scripts/audit-catalog.mjs",
    "check:resend": "node scripts/check-resend-config.mjs",
    "check:resend-api": "node scripts/check-resend-api.mjs",
    "check:ready": "node scripts/launch-check.mjs",
    "resend:key": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/write-resend-env.ps1 -Clipboard",
    "resend:emails": "node scripts/set-resend-emails.mjs",
    "preview:auth-smtp": "node scripts/configure-preview-auth-smtp.mjs",
    "preview:email-stack": "node scripts/apply-preview-email-stack.mjs --redeploy",
    "preview:email-wait": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/wait-clipboard-resend-and-apply.ps1",
    "test": "node --test \"src/**/*.test.js\"",
    "data:openverse-food-pilot": "node scripts/pilot-openverse-food.mjs",
    "data:openverse-food-bulk": "node scripts/assign-openverse-food-bulk.mjs",
    "data:food-illustration-quality": "node scripts/fix-food-illustration-quality.mjs",
    "data:food-illustration-diversify": "node scripts/diversify-food-illustrations.mjs",
    "preview": "vite preview",
    "data:osm": "node scripts/fetch-osm.mjs && node scripts/generate-osm-places.mjs",
    "check:places": "node scripts/check-places.mjs",
    "check:supabase": "node scripts/check-supabase-schema.mjs",
    "data:price-estimates": "node scripts/generate-price-estimates.mjs",
    "data:google-ratings": "node scripts/fetch-google-ratings.mjs",
    "data:google-maps-links": "node scripts/generate-google-maps-links.mjs",
    "data:place-enrichment": "node scripts/generate-place-enrichment.mjs",
    "data:osm-coords": "node scripts/fetch-osm-coords.mjs && node scripts/generate-place-coordinates.mjs",
    "data:coordinates": "node scripts/generate-place-coordinates.mjs",
    "data:official-photos": "node scripts/scan-official-photos.mjs",
    "data:food-photo-pilot": "node scripts/pilot-food-photos.mjs",
    "data:pixabay-illustrations": "node scripts/fetch-pixabay-illustrations.mjs",
    "launch:check": "node scripts/launch-check.mjs",
    "test:promotion-sql": "node scripts/test-promotion-migration-isolated.mjs",
    "preview:email-stack": "node scripts/apply-preview-email-stack.mjs --redeploy"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "@supabase/supabase-js": "^2.118.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "maplibre-gl": "^6.18.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
